---
import TopNav from '../components/TopNav.astro'
import TopNavDev from '../components/TopNavDev.astro'
import Footer from '../components/Footer.astro'
import SocialPreview from '../components/SocialPreview.astro'
import config from '../../website.config'
import { getLangFromUrl } from '../utils/i18n'
import { getCanonicalPath } from '../utils/getCanonicalPath'
import '../styles/global.css'

interface Props {
  title: string
  /**
   * Meta description of the page, also reused for the social preview. Comes
   * from the content: `summary` on a blog post, `description` on a doc, a
   * guide or a `pages` entry.
   */
  description?: string
  /** `article` on blog posts, `website` everywhere else. */
  ogType?: 'website' | 'article'
  staticHeader?: boolean
  image?: ImageMetadata
  /**
   * Bottom padding on the main content area. Defaults to true so content
   * pages (home, features, blog, ...) breathe before the footer. Docs-style
   * layouts with a side rail pass `false` so the sidebar stays flush.
   */
  bottomSpace?: boolean
}

const {
  title,
  description,
  ogType = 'website',
  staticHeader = false,
  image,
  bottomSpace = true,
} = Astro.props
// Index pages carry very short titles ("Blog", "Introduction"), so the brand
// is appended to give them a full document title. It is left out when the title
// already names the brand, and when the suffix would push the title past the
// ~60 characters a SERP displays.
const brandedTitle = `${title} | ${config.siteName}`
const pageTitle
  = title.includes(config.siteName) || brandedTitle.length > 60 ? title : brandedTitle
const currentPath = Astro.url.pathname
const lang = getLangFromUrl(Astro.url)
const isDevSection = currentPath.includes('/developers') || currentPath.includes('/api')
const canonicalPath = getCanonicalPath(currentPath)
const hasLangPrefix = canonicalPath.startsWith(`/${lang}`)
const altPath = (l: string) => hasLangPrefix ? canonicalPath.replace(`/${lang}`, `/${l}`) : canonicalPath

/** Absolute URL of a site-relative path, for the tags that require one. */
const absoluteUrl = (path: string) => new URL(path, Astro.site).href
const canonicalUrl = absoluteUrl(canonicalPath)
const mdAlternateUrl = absoluteUrl(`${canonicalPath}.md`)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {hasLangPrefix && config.langs.map((l) => (
      <link rel="alternate" hreflang={l} href={absoluteUrl(altPath(l))} />
    ))}
    {hasLangPrefix && (
      <link rel="alternate" hreflang="x-default" href={absoluteUrl(altPath(config.defaultLang))} />
    )}
    <link
      rel="alternate"
      type="text/markdown"
      href={mdAlternateUrl}
    />
    <SocialPreview
      title={pageTitle}
      description={description}
      image={image}
      type={ogType}
      url={canonicalUrl}
      lang={lang}
    />
    <!--
      Drop analytics / chat widgets here. Guard with `import.meta.env.PROD`
      so they never load in local dev. Example:

      {import.meta.env.PROD && (
        <script defer src="https://analytics.example.com/script.js"></script>
      )}
    -->
  </head>
  <body class="min-h-dvh flex flex-col">
    {isDevSection ? <TopNavDev /> : <TopNav staticHeader={staticHeader} />}
    <main class:list={['flex-1 flex flex-col items-center', bottomSpace && 'pb-24']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

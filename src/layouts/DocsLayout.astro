---
import BaseLayout from './BaseLayout.astro'
import Sidebar from '../components/Sidebar.astro'

interface Props {
  title: string
  /** Appends ` | <brand>` to the document title. */
  titleBrand?: boolean
  description?: string
  section: 'docs' | 'guides' | 'developers' | 'api'
}

const { title, titleBrand = true, description, section } = Astro.props
---

<BaseLayout title={title} titleBrand={titleBrand} description={description} bottomSpace={false}>
  <div class="w-full flex min-h-[calc(100vh-56px)]">
    <Sidebar section={section} />
    <div class="flex-1 min-w-0 py-8 px-6 md:px-12 max-w-5xl">
      <slot />
    </div>
  </div>
</BaseLayout>

# Redirects, Netlify syntax. Cloudflare keeps the rules without conditions (see
# src/integrations/cloudflare-redirects.ts) and redirects the root in worker/index.ts.
# Root '/' redirects to the user's browser language.
# The `!` forces the rule even when a file exists at '/'.
# See https://docs.netlify.com/routing/redirects/redirect-options/#country-language-based-redirects
/  /fr  302!  Language=fr
/  /en  302!
